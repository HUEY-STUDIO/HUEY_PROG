# =============================================================================
# 국내 건축 대지 법규 자동 조회 프로그램 - 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 발급받은 키를 채워 넣으세요.
#   cp .env.example .env
# 키 발급 방법은 docs/API_KEYS.md 참고
# =============================================================================

# -----------------------------------------------------------------------------
# 1) 도로명주소 API (https://business.juso.go.kr)
#    주소 검색 -> 법정동코드/본번/부번/산여부 (PNU 조립에 사용)
#    승인키 종류: '검색 API' 승인키 (개발용은 신청 즉시 발급)
# -----------------------------------------------------------------------------
JUSO_API_KEY=

# -----------------------------------------------------------------------------
# 2) 브이월드 (https://api.vworld.kr)
#    Geocoder API 2.0 - 주소 -> 좌표(경위도)
#    * 지오코더는 일별 요청 건수 제한이 있으므로 트래픽 증가 시 초과신청 필요
# -----------------------------------------------------------------------------
VWORLD_API_KEY=

# -----------------------------------------------------------------------------
# 3) 공공데이터포털 (https://www.data.go.kr) 서비스키
#    - 토지이용계획(용도지역/지구) 속성 조회
#    - 토지특성(지목/면적) 조회
#    - 건축물대장 조회
#    포털에서 발급되는 '일반 인증키(Decoding)' 값을 그대로 넣으세요.
#    (Encoding 값을 넣으면 %2B 등이 이중 인코딩되어 SERVICE_KEY_IS_NOT_REGISTERED_ERROR 발생)
# -----------------------------------------------------------------------------
DATA_GO_KR_SERVICE_KEY=

# -----------------------------------------------------------------------------
# 4) 국가법령정보 공동활용 (https://open.law.go.kr)
#    OC 값 = 신청 시 등록한 이메일의 '@ 앞부분' (예: hong@gmail.com -> hong)
# -----------------------------------------------------------------------------
LAW_OC=

# =============================================================================
# 엔드포인트 오버라이드 (선택)
# 공공 API는 운영 주체가 경로를 바꾸는 경우가 있습니다. 코드 수정 없이
# .env 로 교체할 수 있도록 모든 base URL 을 설정값으로 노출해 두었습니다.
# 값을 비워두면 app/config.py 의 기본값이 사용됩니다.
# =============================================================================
# JUSO_BASE_URL=https://business.juso.go.kr/addrlink/addrLinkApi.do
# VWORLD_BASE_URL=https://api.vworld.kr/req/address
# NSDI_BASE_URL=http://apis.data.go.kr/1611000/nsdi
# BLDRGST_BASE_URL=http://apis.data.go.kr/1613000/BldRgstHubService
# LAW_BASE_URL=https://www.law.go.kr/DRF

# =============================================================================
# 동작 설정 (선택)
# =============================================================================
# HTTP_TIMEOUT=10.0          # 외부 API 호출 타임아웃(초)
# HTTP_MAX_RETRIES=2         # 5xx/타임아웃 재시도 횟수
# CACHE_TTL_SECONDS=3600     # 응답 캐시 TTL(초). 0 이면 캐시 비활성화
# LOG_LEVEL=INFO
